---
import { getEntry, render } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import { siteConfig } from '../config/site';

const studyCopy = await getEntry('websiteCopy', 'study');

if (!studyCopy) {
  throw new Error('No se encontró el contenido editorial de presentación del estudio.');
}

const { Content: StudyCopy } = await render(studyCopy);
---

<SiteLayout
  title="El estudio"
  description="Conocé La Greca & Asoc., estudio jurídico con más de 55 años de trayectoria en Villa Lugano, Ciudad Autónoma de Buenos Aires."
>
  <section class="page-hero page-hero--cream">
    <div class="container page-hero__inner">
      <p class="eyebrow">LA GRECA &amp; ASOC. · ESTUDIO JURÍDICO</p>
      <h1>Una trayectoria al servicio de las personas y las empresas</h1>
      <p>Más de 55 años de experiencia acompañando consultas jurídicas en Villa Lugano y en la Ciudad Autónoma de Buenos Aires.</p>
    </div>
  </section>
  <section class="section">
    <div class="container prose-column">
      <p class="eyebrow">Nuestra forma de trabajo</p>
      <h2>{studyCopy.data.title}</h2>
      <div class="website-copy website-copy--study">
        <StudyCopy />
      </div>
      <a class="button button--primary" href="/contacto/">Solicitar una consulta</a>
    </div>
  </section>
  <section class="section section-contact-band">
    <div class="container section-contact-band__inner">
      <div>
        <p class="eyebrow eyebrow--light">Encontranos</p>
        <h2>Chilavert 6714, Villa Lugano</h2>
      </div>
      <p>{siteConfig.address.formatted}</p>
      <a class="button button--light" href="/contacto/">Información de contacto</a>
    </div>
  </section>
</SiteLayout>
