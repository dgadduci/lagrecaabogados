---
import ReviewNotice from '../components/ReviewNotice.astro';
import ServiceCard from '../components/ServiceCard.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { siteConfig } from '../config/site';
import { featuredIndividualServices } from '../data/services';
---

<SiteLayout
  title="Estudio Jurídico en Villa Lugano"
  description="La Greca & Asoc.: asesoramiento y representación jurídica para particulares y empresas en Villa Lugano, CABA. Más de 55 años de trayectoria."
>
  <section class="home-hero">
    <div class="container home-hero__inner">
      <div class="home-hero__copy">
        <p class="eyebrow">LA GRECA &amp; ASOC. · ESTUDIO JURÍDICO</p>
        <h1>Más de 55 años de trayectoria</h1>
        <p class="home-hero__lead">Asesoramiento y representación jurídica para particulares y empresas.</p>
        <div class="button-row">
          <a class="button button--primary" href="/contacto/">Solicitar una consulta</a>
          <a class="button button--outline" href="/estudio/">Conocer el estudio</a>
        </div>
      </div>
      <div class="home-hero__mark" aria-hidden="true">
        <span>LA GRECA</span>
        <span>&amp; ASOC.</span>
        <i></i>
        <small>ESTUDIO JURÍDICO</small>
      </div>
    </div>
    <div class="home-hero__rule" aria-hidden="true"></div>
  </section>

  <section class="section section-intro">
    <div class="container split-section">
      <div>
        <p class="eyebrow">El estudio</p>
        <h2>Experiencia jurídica con atención cercana</h2>
      </div>
      <div class="section-intro__body">
        <p>La Greca &amp; Asoc. brinda asesoramiento y representación jurídica a particulares, comerciantes, pymes y empresas medianas.</p>
        <p>Con más de 55 años de trayectoria, el estudio trabaja para comprender cada consulta y acompañar a sus clientes en sus asuntos jurídicos.</p>
        <a class="text-link" href="/estudio/">Conocer nuestra trayectoria <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section section-services" aria-labelledby="services-heading">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Áreas de práctica</p>
          <h2 id="services-heading">Asesoramiento para cada etapa</h2>
        </div>
        <a class="text-link" href="/particulares/">Ver servicios para particulares <span aria-hidden="true">→</span></a>
      </div>
      <ReviewNotice />
      <div class="service-grid">
        {featuredIndividualServices.map((service) => (
          <ServiceCard href={`/particulares/${service.slug}/`} title={service.title} description={service.description} />
        ))}
      </div>
    </div>
  </section>

  <section class="business-feature">
    <div class="container business-feature__inner">
      <div class="business-feature__copy">
        <p class="eyebrow eyebrow--light">Para pymes y empresas medianas</p>
        <h2>Asesoramiento jurídico permanente para acompañar el crecimiento de tu empresa</h2>
        <p>Abonos mensuales, asesoramiento preventivo y acompañamiento en temas laborales, comerciales y societarios.</p>
        <a class="button button--light" href="/empresas/">Conocer el servicio para empresas</a>
      </div>
      <ul class="business-feature__list">
        <li>Derecho laboral empresarial</li>
        <li>Contratos comerciales</li>
        <li>Cobro de créditos</li>
        <li>Prevención de conflictos</li>
        <li>Representación judicial</li>
        <li>Asesoramiento societario</li>
      </ul>
    </div>
  </section>

  <section class="section section-trajectory">
    <div class="container trajectory-card">
      <p class="trajectory-card__number" aria-hidden="true">55+</p>
      <div>
        <p class="eyebrow">Trayectoria institucional</p>
        <h2>{siteConfig.experienceLabel}</h2>
        <p>Más de cinco décadas de trabajo jurídico. Una trayectoria que se expresa en el compromiso, la continuidad y la atención de cada consulta.</p>
      </div>
    </div>
  </section>

  <section class="section contact-preview">
    <div class="container contact-preview__inner">
      <div>
        <p class="eyebrow">Contacto</p>
        <h2>Estamos en Villa Lugano</h2>
        <address>{siteConfig.address.formatted}</address>
        <a class="text-link" href="/contacto/">Ver ubicación y medios de contacto <span aria-hidden="true">→</span></a>
      </div>
      <div class="contact-preview__actions">
        <a class="button button--primary" href="/contacto/">Solicitar una consulta</a>
        <WhatsAppButton text="Consultar por WhatsApp" variant="secondary" />
      </div>
    </div>
  </section>
</SiteLayout>
