---
import ReviewNotice from '../../components/ReviewNotice.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { individualServices } from '../../data/services';

interface Props {
  service: (typeof individualServices)[number];
}

export function getStaticPaths() {
  return individualServices.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const relatedServices = individualServices.filter((item) => item.slug !== service.slug).slice(0, 3);
---

<SiteLayout title={service.title} description={service.description}>
  <section class="page-hero page-hero--cream">
    <div class="container page-hero__inner">
      <nav class="breadcrumbs" aria-label="Ruta de navegación">
        <a href="/">Inicio</a><span aria-hidden="true">/</span><a href="/particulares/">Particulares</a><span aria-hidden="true">/</span><span aria-current="page">{service.title}</span>
      </nav>
      <p class="eyebrow">Servicios para particulares</p>
      <h1>{service.title}</h1>
      <p>{service.description}</p>
      <a class="button button--primary" href="/contacto/">Solicitar una consulta</a>
    </div>
  </section>
  <section class="section">
    <div class="container service-detail">
      <div class="service-detail__main">
        <ReviewNotice />
        <h2>Asesoramiento según cada caso</h2>
        <p>{service.introduction}</p>
        <p>El alcance de una consulta depende de las circunstancias particulares y de la documentación que pueda revisarse. La información de esta página es general y no reemplaza el asesoramiento profesional individualizado.</p>
        <h2>Temas de consulta</h2>
        <ul class="check-list">
          {service.focus.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <aside class="service-detail__aside">
        <p class="eyebrow">¿Querés conversar con el estudio?</p>
        <h2>Contanos brevemente tu consulta</h2>
        <p>El estudio puede conocer los detalles y evaluar el asesoramiento que corresponda.</p>
        <a class="button button--primary" href="/contacto/">Solicitar una consulta</a>
        <WhatsAppButton text="Consultar por WhatsApp" variant="secondary" />
      </aside>
    </div>
  </section>
  <section class="section section-related">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow">También puede interesarte</p><h2>Otros servicios para particulares</h2></div>
        <a class="text-link" href="/particulares/">Ver todas las áreas <span aria-hidden="true">→</span></a>
      </div>
      <div class="service-grid service-grid--three">
        {relatedServices.map((item) => (
          <ServiceCard href={`/particulares/${item.slug}/`} title={item.title} description={item.description} />
        ))}
      </div>
    </div>
  </section>
</SiteLayout>
